{
  "version": 1,
  "name": "Demo",
  "nodes": [
    {
      "id": "n1",
      "kind": "claude",
      "name": "planner",
      "instructions": "Read the issue tracker and produce an implementation plan.\nBreak it into slices with file-level detail.\nFlag any security-sensitive surfaces.",
      "expects": "a list of open issues",
      "produces": "docs/plan.md",
      "inputs": [],
      "outputs": [{ "name": "plan" }],
      "x": 40,
      "y": 60
    },
    {
      "id": "n2",
      "kind": "opencode",
      "name": "implementer",
      "instructions": "Implement the plan slice by slice. Run npm test after each slice and keep the build green.",
      "expects": "docs/plan.md",
      "produces": "src changes, green tests",
      "inputs": [{ "name": "plan" }],
      "outputs": [{ "name": "code" }],
      "x": 340,
      "y": 60
    },
    {
      "id": "n3",
      "kind": "terminal",
      "name": "verify",
      "instructions": "Run the full suite and audit the diff.",
      "expects": "code changes",
      "produces": "test report",
      "inputs": [{ "name": "code" }],
      "outputs": [],
      "x": 640,
      "y": 60
    }
  ],
  "edges": [
    { "id": "e1", "from": "n1", "to": "n2", "fromOutput": "plan", "toInput": "plan" },
    { "id": "e2", "from": "n2", "to": "n3", "fromOutput": "code", "toInput": "code" }
  ]
}
