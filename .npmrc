# Pin the public npm registry explicitly so installs never silently divert
# to a machine- or user-level mirror (see ~/.npmrc, `npm config get
# registry`). History: 2026-08-07 the local machine's registry config 403'd
# on the `eslint` tarball while CI's default registry fetched it fine —
# eslint is declared in package.json but was never installed locally, so
# `bun run lint` silently skipped. Bun and npm both honor this file;
# project-level config outranks user-level.
#
# The `xlsx` dependency is an explicit tarball URL
# (https://cdn.sheetjs.com/...) and bypasses the registry entirely, so this
# pin cannot affect it; bun.lock's registry-less entries resolve against
# exactly this default, so `bun install --frozen-lockfile` matches CI's
# resolution byte-for-byte.
registry=https://registry.npmjs.org/
